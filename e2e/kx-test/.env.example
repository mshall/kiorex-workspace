# e2e/kx-test environment file. Copy to `.env` (git-ignored) only if you need to override a default. NOTHING here is secret and nothing secret belongs here:
# secrets are read at run time from AWS (Secrets Manager /kx/test/e2e and, for one-time codes, the Passport container log through SSM) with your own AWS CLI credentials.

# Which environment of the URL registry (_docs/registry/service-url-registry.yaml) to test. Hosts are never typed here: they come from the registry.
KX_E2E_ENV=test

# AWS CLI context (account 990597228737). Use `AWS_PROFILE=<profile>` if you do not use the default credentials.
AWS_REGION=eu-central-1
# AWS_PROFILE=

# Host that runs the stack (SSM Run Command is used read-only: docker logs of Passport for the mock one-time codes, and one probe of the platform's partner signing).
KX_E2E_INSTANCE=i-0823d9ef0bcda4a52
KX_E2E_PASSPORT_CONTAINER=kx-test-passport-1

# Secrets Manager id holding the TOTP secrets of the privileged demo accounts (created by scripts/provision-e2e-secrets.sh).
KX_E2E_SECRET_ID=/kx/test/e2e

# Passport allows 5 one-time codes per phone and 20 per IP and hour. Saved sessions (git-ignored .auth/) are reused for this many minutes
# (default 6 for the platform apps whose access token lives 15 minutes, 40 for Pharmacy and Lab). KX_E2E_FRESH=1 forces new sign-ins.
# KX_E2E_SESSION_MINUTES=
# KX_E2E_FRESH=1

# Optional: override one origin, for example to test a different deployment (KX_E2E_URL_<service id with dots as underscores>).
# KX_E2E_URL_KIOREX_API=https://api.test.kiorex.com
